---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.vue';
import { getCollection } from 'astro:content';
import { CATEGORY_META } from '../content.config';
import { buildFolderTree, topFolders, stripCategory } from '../lib/tree';

const allNotes = await getCollection('notes');

const categoryStats = Object.entries(CATEGORY_META).map(([id, meta]) => {
  const notes = allNotes.filter(n => n.data.category === id);
  // 分区卡片上展示该板块的顶层文件夹（体现原始目录层级）
  const tree = buildFolderTree(notes.map(n => ({
    title: n.data.title,
    slug: stripCategory(n.slug),
    folderPath: n.data.folderPath,
    updated: n.data.updated,
    readingTime: n.data.readingTime,
    tags: n.data.tags,
    featured: n.data.featured,
    summary: n.data.summary,
    category: n.data.category,
  })));
  return {
    id,
    index: `PART ${String(meta.order).padStart(2, '0')}`,
    label: meta.label,
    description: meta.description,
    folders: topFolders(tree, 6),
    folderCount: tree.children.length,
    count: notes.length,
    color: 'var(--accent)',
  };
});

const featuredProjects = allNotes
  .filter(n => n.data.featured && n.data.category === 'projects')
  .map(n => ({ ...n, slug: stripCategory(n.slug) }))  // 剥离分类前缀
  .slice(0, 6);

const skillMatrix = [
  { domain: 'Java 工程栈', tags: 'Spring · Maven · Logback · DevOps', count: allNotes.filter(n => n.data.tags.some(t => ['Java', 'Spring', 'Maven', 'Logback', 'DevOps'].includes(t))).length },
  { domain: 'Python / 数据科学', tags: 'pandas · NumPy · 爬虫', count: allNotes.filter(n => n.data.tags.some(t => ['Python', '数据分析', 'pandas'].includes(t))).length },
  { domain: 'NLP / AI 工程', tags: 'PyTorch · RNN · Seq2Seq', count: allNotes.filter(n => n.data.tags.some(t => ['NLP', 'PyTorch', 'AI'].includes(t))).length },
  { domain: 'Linux / 工具链', tags: '命令手册 · 远程工具', count: allNotes.filter(n => n.data.tags.some(t => ['Linux', '工具'].includes(t))).length },
];
---

<BaseLayout title="jcstrong.dev · 笔记档案">
  <div class="container">
    <section class="intro">
      <h1 class="intro-title">笔记档案</h1>
      <p class="intro-sub">218 篇技术沉淀 · 按 项目实战 / 技能图谱 / 工程实践 / 学习笔记 四维组织</p>
    </section>

    <Hero categories={categoryStats} />

    <hr class="divider" />

    <section class="featured">
      <div class="section-header">
        <h2 class="section-title">精选项目实战</h2>
        <a href="/notes/projects" class="section-link">查看全部 →</a>
      </div>
      <div class="project-grid">
        {featuredProjects.map(project => (
          <a href={`/notes/projects/${project.slug}`} class="project-card card-hover">
            <div class="project-meta mono">{project.data.tags.slice(0, 2).join(' · ')}</div>
            <h3 class="project-title">{project.data.title}</h3>
            <p class="project-summary">{project.data.summary}</p>
            <div class="project-tags">
              {project.data.tags.map(tag => <span class="tag mono">{tag}</span>)}
            </div>
          </a>
        ))}
      </div>
    </section>

    <hr class="divider" />

    <section class="skills">
      <h2 class="section-title">技能矩阵</h2>
      <div class="skill-grid">
        {skillMatrix.map(skill => (
          <div class="skill-row">
            <span class="skill-domain">{skill.domain}</span>
            <span class="skill-tags mono">{skill.tags}</span>
            <span class="skill-count mono">{skill.count} 篇</span>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
.intro {
  padding: 48px 0 24px;
  text-align: left;
}

.intro-title {
  font-size: 28px;
  font-weight: 500;
  letter-spacing: -0.02em;
  margin-bottom: 8px;
}

.intro-sub {
  font-size: 13px;
  color: var(--text-tertiary);
  font-family: var(--font-mono);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 16px;
}

.section-title {
  font-size: 14px;
  font-weight: 500;
  letter-spacing: 0.01em;
}

.section-link {
  font-size: 11px;
  color: var(--text-tertiary);
}

.project-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
}

.project-card {
  background: var(--bg-secondary);
  border: 0.5px solid var(--border-tertiary);
  border-radius: var(--radius-md);
  padding: 16px;
  color: var(--text-primary);
  text-decoration: none;
}

.project-meta {
  font-size: 10px;
  color: var(--text-tertiary);
  margin-bottom: 8px;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.project-title {
  font-size: 14px;
  font-weight: 500;
  margin-bottom: 6px;
  line-height: 1.4;
}

.project-summary {
  font-size: 12px;
  color: var(--text-secondary);
  line-height: 1.5;
  margin-bottom: 10px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.project-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
}

.tag {
  font-size: 10px;
  padding: 2px 7px;
  border-radius: 4px;
  background: var(--bg-tertiary);
  color: var(--text-secondary);
}

.skill-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 8px;
}

.skill-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 14px;
  background: var(--bg-secondary);
  border-radius: var(--radius-md);
  border-left: 2px solid var(--accent);
}

.skill-domain {
  font-size: 12px;
  font-weight: 500;
}

.skill-tags {
  font-size: 11px;
  color: var(--text-tertiary);
  flex: 1;
  text-align: center;
}

.skill-count {
  font-size: 11px;
  color: var(--accent);
}

@media (max-width: 900px) {
  .project-grid { grid-template-columns: repeat(2, 1fr); }
  .skill-grid { grid-template-columns: 1fr; }
}

@media (max-width: 480px) {
  .project-grid { grid-template-columns: 1fr; }
}
</style>
