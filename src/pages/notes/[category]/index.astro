---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import NoteCard from '../../../components/NoteCard.vue';
import CategoryTree from '../../../components/CategoryTree.vue';
import { getCollection } from 'astro:content';
import { CATEGORY_META } from '../../../content.config';
import { buildFolderTree, flattenTree, stripCategory } from '../../../lib/tree';

export async function getStaticPaths() {
  const allNotes = await getCollection('notes');
  return Object.keys(CATEGORY_META).map(cat => ({
    params: { category: cat },
  }));
}

const { category } = Astro.params;
const meta = CATEGORY_META[category as keyof typeof CATEGORY_META];

const allNotes = await getCollection('notes');
const categoryNotes = allNotes
  .filter(n => n.data.category === category)
  .sort((a, b) => new Date(b.data.updated).getTime() - new Date(a.data.updated).getTime());

const categoryStats = Object.entries(CATEGORY_META).map(([id, m]) => ({
  id,
  label: m.label,
  count: allNotes.filter(n => n.data.category === id).length,
}));

// 当前板块的文件夹层级树（扁平化，带缩进深度）
const tree = flattenTree(buildFolderTree(categoryNotes.map(n => ({
  title: n.data.title,
  slug: stripCategory(n.slug),
  folderPath: n.data.folderPath,
  updated: n.data.updated,
  readingTime: n.data.readingTime,
  tags: n.data.tags,
  featured: n.data.featured,
  summary: n.data.summary,
  category: n.data.category,
}))));

const notesForRender = categoryNotes.map(n => ({
  title: n.data.title,
  slug: stripCategory(n.slug),
  category: n.data.category,
  folderPath: n.data.folderPath,
  tags: n.data.tags,
  featured: n.data.featured,
  updated: n.data.updated,
  readingTime: n.data.readingTime,
  summary: n.data.summary,
}));
---

<BaseLayout title={`${meta.label} · jcstrong.dev`}>
  <div class="list-page">
    <div class="list-header">
      <div class="breadcrumb mono">
        <a href="/">首页</a> / <span>{meta.label}</span>
        <span class="crumb-count">{categoryNotes.length} 篇</span>
      </div>
      <div class="search-bar">
        <input type="text" id="search" placeholder={`在 ${categoryNotes.length} 篇笔记中搜索...`} class="search-input" />
        <span class="search-shortcut mono">⌘ K</span>
      </div>
    </div>

    <div class="list-body">
      <CategoryTree
        categories={categoryStats}
        currentCategory={category}
        tree={tree}
        client:idle
      />

      <main class="list-main">
        <div class="list-title-row">
          <div>
            <h1 class="list-title">{meta.label}</h1>
            <p class="list-desc" id="list-desc">
              {categoryNotes.length} 篇 · 按 <span class="mono">Typora 目录层级</span> 树状分区 · {meta.description}
            </p>
          </div>
          <div class="sort-options mono">
            <button class="sort-btn sort-active" data-sort="updated">最近更新</button>
            <button class="sort-btn" data-sort="title">按标题</button>
            <button class="sort-btn" data-sort="readingTime">按篇幅</button>
          </div>
        </div>

        <div class="filter-bar" id="filter-bar" hidden>
          <span class="filter-label mono">当前分区</span>
          <span class="filter-path mono" id="filter-path"></span>
          <button class="filter-clear" id="filter-clear">清除 ✕</button>
        </div>

        <div class="note-list" id="flat-note-list">
          {notesForRender.map(note => <NoteCard note={note} />)}
        </div>

        <div class="empty" id="empty-hint" hidden>
          <p>该分区下暂无笔记</p>
        </div>
      </main>
    </div>
  </div>
</BaseLayout>

<script>
  // 客户端：按文件夹层级筛选 + 排序（纯静态页，无需后端）
  const list = document.getElementById('flat-note-list');
  const cards = list ? Array.from(list.querySelectorAll('[data-folder]')) as HTMLElement[] : [];
  const filterBar = document.getElementById('filter-bar');
  const filterPath = document.getElementById('filter-path');
  const emptyHint = document.getElementById('empty-hint');
  const listDesc = document.getElementById('list-desc');
  const totalCount = cards.length;
  let activeFolder = '';
  let sortBy = 'updated';

  function applyFilter() {
    let visible = 0;
    for (const card of cards) {
      const folder = card.dataset.folder || '';
      const match = !activeFolder || folder === activeFolder || folder.startsWith(activeFolder + '/');
      card.hidden = !match;
      if (match) visible++;
    }
    if (filterBar) filterBar.hidden = !activeFolder;
    if (filterPath) filterPath.textContent = activeFolder || '';
    if (emptyHint) emptyHint.hidden = visible > 0;
    if (listDesc) {
      listDesc.textContent = activeFolder
        ? `${visible} / ${totalCount} 篇 · 分区：${activeFolder}`
        : `${totalCount} 篇 · 按 Typora 目录层级 树状分区`;
    }
  }

  function applySort(mode: string) {
    if (!list) return;
    const sorted = [...cards].sort((a, b) => {
      if (mode === 'title') return (a.dataset.title || '').localeCompare(b.dataset.title || '', 'zh-CN');
      if (mode === 'readingTime') return Number(b.dataset.reading) - Number(a.dataset.reading);
      return (b.dataset.updated || '').localeCompare(a.dataset.updated || '');
    });
    sorted.forEach(c => list.appendChild(c));
  }

  // 侧边栏（Vue 组件）通过自定义事件驱动筛选
  document.addEventListener('select-folder', (e: Event) => {
    activeFolder = (e as CustomEvent<string>).detail || '';
    applyFilter();
  });
  document.addEventListener('select-sort', (e: Event) => {
    sortBy = (e as CustomEvent<string>).detail || 'updated';
    document.querySelectorAll('.sort-btn').forEach(btn => {
      btn.classList.toggle('sort-active', (btn as HTMLElement).dataset.sort === sortBy);
    });
    applySort(sortBy);
  });

  document.querySelectorAll('.sort-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      sortBy = (btn as HTMLElement).dataset.sort || 'updated';
      document.querySelectorAll('.sort-btn').forEach(b => b.classList.remove('sort-active'));
      btn.classList.add('sort-active');
      applySort(sortBy);
    });
  });

  document.getElementById('filter-clear')?.addEventListener('click', () => {
    activeFolder = '';
    applyFilter();
  });

  // 支持 URL 锚点深链：#folder=Python/Python_web
  const hashFolder = decodeURIComponent(location.hash.replace(/^#folder=/, ''));
  if (hashFolder && location.hash.startsWith('#folder=')) {
    activeFolder = hashFolder;
    applyFilter();
  }
</script>

<style>
.list-page {
  min-height: calc(100vh - 100px);
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 24px;
  border-bottom: 0.5px solid var(--border-tertiary);
}

.breadcrumb {
  font-size: 11px;
  color: var(--text-tertiary);
}

.breadcrumb a {
  color: var(--text-secondary);
}

.crumb-count {
  margin-left: 8px;
  padding: 1px 6px;
  background: var(--bg-secondary);
  border-radius: var(--radius-sm);
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 8px;
}

.search-input {
  font-size: 12px;
  padding: 6px 12px;
  width: 280px;
  background: var(--bg-secondary);
  border: 0.5px solid var(--border-tertiary);
  border-radius: var(--radius-md);
  color: var(--text-primary);
  outline: none;
}

.search-input:focus {
  border-color: var(--accent);
}

.search-shortcut {
  font-size: 11px;
  padding: 4px 8px;
  background: var(--bg-secondary);
  border: 0.5px solid var(--border-tertiary);
  border-radius: var(--radius-sm);
  color: var(--text-tertiary);
}

.list-body {
  display: flex;
  min-height: 500px;
}

.list-main {
  flex: 1;
  padding: 20px 24px;
  min-width: 0;
}

.list-title-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 14px;
  gap: 16px;
}

.list-title {
  font-size: 18px;
  font-weight: 500;
  margin-bottom: 4px;
}

.list-desc {
  font-size: 11px;
  color: var(--text-tertiary);
}

.sort-options {
  display: flex;
  gap: 12px;
  font-size: 11px;
}

.sort-btn {
  background: none;
  border: none;
  padding: 0 0 2px;
  font-size: 11px;
  font-family: inherit;
  color: var(--text-tertiary);
  cursor: pointer;
}

.sort-btn.sort-active {
  color: var(--text-primary);
  border-bottom: 1px solid var(--text-primary);
}

.filter-bar {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  margin-bottom: 12px;
  background: var(--accent-light);
  border-radius: var(--radius-md);
  font-size: 11px;
}

.filter-label {
  color: var(--text-tertiary);
}

.filter-path {
  color: var(--accent-text);
  flex: 1;
}

.filter-clear {
  background: none;
  border: none;
  color: var(--accent);
  font-size: 11px;
  cursor: pointer;
}

.note-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.empty {
  padding: 48px 0;
  text-align: center;
  color: var(--text-tertiary);
  font-size: 13px;
}
</style>
